      "type": "array"
    },
    "draft_fingerprint": {
      "minLength": 1,
      "title": "Draft Fingerprint",
      "type": "string"
    },
    "draft_name": {
      "minLength": 1,
      "title": "Draft Name",
      "type": "string"
    },
    "reviewer": {
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "schema_version": {
      "const": "kip.golden-draft-review.v1",
      "default": "kip.golden-draft-review.v1",
      "title": "Schema Version",
      "type": "string"
    }
