{
  "$defs": {
    "AssertionCandidate": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "contradicts_assertion_ids": {
          "items": {
            "type": "string"
          },
          "title": "Contradicts Assertion Ids",
          "type": "array"
        },
        "derivation": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationDerivation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CandidateEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "migrates_assertion_ids": {
          "items": {
            "type": "string"
          },
          "title": "Migrates Assertion Ids",
          "type": "array"
        },
        "object_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Entity Id"
        },
        "object_value": {
          "default": null,
          "title": "Object Value"
        },
        "ontology_version": {
          "title": "Ontology Version",
          "type": "string"
        },
        "origin": {
          "title": "Origin",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "review_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Note"
        },
        "review_risk": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Review Risk",
          "type": "string"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "approved",
            "rejected",
            "superseded"
          ],
          "title": "Status",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "required": [
        "id",
        "subject_id",
        "predicate",
        "origin",
        "ontology_version"
      ],
      "title": "AssertionCandidate",
      "type": "object"
    },
    "AutoApprovedRelation": {
      "additionalProperties": false,
      "description": "One relation candidate approved by the calibrated auto-approve policy.\n\nRecorded for audit visibility alongside `OntologyMiningSummary`. The\nunderlying assertion is approved through the same path as human review\n(see `KnowledgeUseCases.review_approve`) and stays fully revocable via\nthe ordinary `review revoke` path like any other approved assertion.",
      "properties": {
        "assertion_id": {
          "title": "Assertion Id",
          "type": "string"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "precision": {
          "title": "Precision",
          "type": "number"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "sample_size": {
          "title": "Sample Size",
          "type": "integer"
        }
      },
      "required": [
        "candidate_id",
        "assertion_id",
        "predicate",
        "precision",
        "sample_size"
      ],
      "title": "AutoApprovedRelation",
      "type": "object"
    },
    "CandidateEvidence": {
      "additionalProperties": false,
      "properties": {
        "content_unit_id": {
          "minLength": 1,
          "title": "Content Unit Id",
          "type": "string"
        },
        "locator": {
          "additionalProperties": true,
          "title": "Locator",
          "type": "object"
        },
        "quote_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Hash"
        },
        "source_revision_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Revision Sha256"
        }
      },
      "required": [
        "content_unit_id"
      ],
      "title": "CandidateEvidence",
      "type": "object"
    },
    "EntityCandidate": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "canonical_name": {
          "minLength": 1,
          "title": "Canonical Name",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "derivation": {
          "$ref": "#/$defs/RelationDerivation"
        },
        "entity_type": {
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CandidateEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "fingerprint": {
          "minLength": 1,
          "title": "Fingerprint",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "ontology_version": {
          "minLength": 1,
          "title": "Ontology Version",
          "type": "string"
        },
        "origin": {
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "review_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Note"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "approved",
            "rejected",
            "superseded"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "fingerprint",
        "entity_type",
        "canonical_name",
        "origin",
        "ontology_version",
        "evidence",
        "derivation"
      ],
      "title": "EntityCandidate",
      "type": "object"
    },
    "GenerationUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "title": "GenerationUsage",
      "type": "object"
    },
    "MinedProposalSkip": {
      "additionalProperties": false,
      "description": "One invalid or duplicate mined proposal that was skipped, with a reason.\n\nA skipped proposal never becomes a candidate; recording it keeps a single\nbad proposal from failing the whole mining batch while preserving an\nauditable per-proposal explanation.",
      "properties": {
        "kind": {
          "enum": [
            "entity",
            "relation",
            "evidence_unit"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference",
        "reason"
      ],
      "title": "MinedProposalSkip",
      "type": "object"
    },
    "ModelRevision": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "revision"
      ],
      "title": "ModelRevision",
      "type": "object"
    },
    "RelationDerivation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "manual",
            "deterministic",
            "model",
            "ontology_migration"
          ],
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "kind",
        "name",
        "revision"
      ],
      "title": "RelationDerivation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "auto_approved": {
      "items": {
        "$ref": "#/$defs/AutoApprovedRelation"
      },
      "title": "Auto Approved",
      "type": "array"
    },
    "entity_candidates": {
      "items": {
        "$ref": "#/$defs/EntityCandidate"
      },
      "title": "Entity Candidates",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ModelRevision"
    },
    "provider_request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Request Id"
    },
    "relation_candidates": {
      "items": {
        "$ref": "#/$defs/AssertionCandidate"
      },
      "title": "Relation Candidates",
      "type": "array"
    },
    "schema_version": {
      "const": "kip.ontology-mining.v1",
      "default": "kip.ontology-mining.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "skipped": {
      "items": {
        "$ref": "#/$defs/MinedProposalSkip"
      },
      "title": "Skipped",
      "type": "array"
    },
    "usage": {
      "$ref": "#/$defs/GenerationUsage"
    }
  },
  "required": [
    "model",
    "usage"
  ],
  "title": "OntologyMiningSummary",
  "type": "object"
}
