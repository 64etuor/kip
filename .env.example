# Runtime
KIP_ENV=development
KIP_CONFIG=config/kip.toml
KIP_WORKSPACE=default
KIP_PRINCIPAL_ID=principal_local
KIP_ACL_SCOPES=workspace:default
KIP_LOG_LEVEL=INFO

# PostgreSQL - use URL encoding for special characters
POSTGRES_DB=kip
POSTGRES_USER=kip_owner
POSTGRES_PASSWORD=change-me-before-use
KIP_DATABASE_URL=postgresql://kip_owner:change-me-before-use@127.0.0.1:5432/kip
KIP_DATABASE_STATEMENT_TIMEOUT_MS=15000
KIP_POSTGRES_PORT=5432
KIP_POSTGRES_IMAGE=pgvector/pgvector:0.8.2-pg18-trixie

# API - empty is allowed only in development on loopback
KIP_API_HOST=127.0.0.1
KIP_API_PORT=8080
KIP_API_KEY=replace-with-a-long-random-secret
KIP_ADMIN_KEY=replace-with-a-different-long-random-secret
KIP_MAX_REQUEST_BYTES=10485760
KIP_IDENTITY_MODE=api_key
KIP_API_PRINCIPAL_ID=bootstrap-operator
KIP_API_ACL_SCOPES=workspace:default
KIP_JWT_ISSUER=
KIP_JWT_AUDIENCE=
KIP_JWT_JWKS_URL=

# Storage
KIP_CAS_PATH=./var/cas
KIP_BACKUP_PATH=./var/backups
KIP_NAS_PATH=./sample-data
# Version-controlled ontology checkout, mounted read-write into the API for
# discovery auto-release (ADR-044) and read-only into the worker.
KIP_ONTOLOGY_PATH=./ontology

# Slack
KIP_SLACK_BOT_TOKEN=

# IMAP
KIP_IMAP_USERNAME=
KIP_IMAP_PASSWORD=

# Optional graph projection
KIP_NEO4J_URI=
KIP_NEO4J_USERNAME=
KIP_NEO4J_PASSWORD=

# Optional local semantic sidecar
KIP_SEMANTIC_HOST=127.0.0.1
KIP_SEMANTIC_PORT=7997
KIP_SEMANTIC_DEVICE=mps
KIP_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
KIP_EMBEDDING_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
KIP_EMBEDDING_SERVED_MODEL=kip-qwen3-embedding-0.6b
KIP_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
KIP_RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
KIP_EMBEDDING_SERVER_BATCH_SIZE=4
KIP_RERANKER_SERVER_BATCH_SIZE=2
KIP_RERANKER_SERVED_MODEL=kip-bge-reranker-v2-m3

# Optional structured generation. The referenced variable is read only when enabled.
KIP_GENERATION_API_KEY=
KIP_OPENAI_API_KEY=
KIP_ANTHROPIC_API_KEY=
