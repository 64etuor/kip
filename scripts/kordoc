#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
if [[ -f "$SCRIPT_DIR/runtime-path.sh" ]]; then source "$SCRIPT_DIR/runtime-path.sh"; fi
source "$SCRIPT_DIR/kordoc-runtime.sh"

if ! command -v node >/dev/null 2>&1; then
  printf 'Kordoc OCR requires Node.js 20.9+; install Node.js, then run ./scripts/bootstrap.sh\n' >&2
  exit 69
fi
package_dir="${KIP_KORDOC_PACKAGE_DIR:-$(kordoc_runtime_root)/node_modules/kordoc}"
model_cache="${KORDOC_MODEL_CACHE:-$PROJECT_ROOT/var/kordoc-models}"
cli="$package_dir/dist/cli.js"

if [[ ! -f "$cli" ]]; then
  printf 'Kordoc %s is not installed; run ./scripts/bootstrap.sh\n' "$(kordoc_expected_version)" >&2
  exit 69
fi

export KORDOC_MODEL_CACHE="$model_cache"
export KORDOC_OFFLINE="${KORDOC_OFFLINE:-1}"
exec node "$cli" "$@"
