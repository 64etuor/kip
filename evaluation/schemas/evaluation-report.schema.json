{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kip.local/schemas/evaluation-report.schema.json",
  "title": "KIP End-to-End RAG Evaluation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "fingerprints",
    "variants",
    "gates",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "kip.evaluation-report.v1"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "started_at", "completed_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "workspace": {"type": "string"},
        "dataset": {"type": "string"},
        "dataset_version": {"type": "string", "minLength": 1},
        "dataset_lifecycle": {
          "enum": ["draft", "reviewed", "golden", "challenge", "canary"]
        },
        "dataset_source_revision": {"type": ["string", "null"]},
        "dataset_gate_eligible": {"type": "boolean"},
        "required_dimensions": {
          "type": "array",
          "items": {"enum": ["retrieval", "answer", "ontology"]},
          "uniqueItems": true
        },
        "warmup_passes": {"type": "integer", "minimum": 0},
        "hardware": {"type": "object"}
      }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus", "dataset", "configuration", "code"],
      "properties": {
        "corpus": {"type": "string", "minLength": 1},
        "dataset": {"type": "string", "minLength": 1},
        "configuration": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "models": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/variant"}
    },
    "gates": {
      "type": "object"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons"],
      "properties": {
        "status": {
          "enum": ["baseline", "promote", "keep_disabled", "reject", "incomplete"]
        },
        "reasons": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "answer_quality": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/answerMetrics"}
    }
  },
  "$defs": {
    "answerMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "case_id",
        "groundedness",
        "completeness",
        "citation_accuracy",
        "refusal_accuracy",
        "claim_precision",
        "claim_recall",
        "citation_precision",
        "citation_recall",
        "refusal_appropriateness",
        "unsupported_claim_count"
      ],
      "properties": {
        "schema_version": {"const": "kip.answer-metrics.v1"},
        "case_id": {"type": "string", "minLength": 1},
        "groundedness": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "completeness": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "citation_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "refusal_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "claim_precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "claim_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "citation_precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "citation_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "refusal_appropriateness": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "unsupported_claim_count": {"type": "integer", "minimum": 0}
      }
    },
    "answerAggregateMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "case_count",
        "groundedness",
        "completeness",
        "citation_accuracy",
        "refusal_accuracy",
        "claim_precision",
        "claim_recall",
        "citation_precision",
        "citation_recall",
        "refusal_appropriateness",
        "unsupported_claim_count"
      ],
      "properties": {
        "schema_version": {"const": "kip.answer-aggregate-metrics.v1"},
        "case_count": {"type": "integer", "minimum": 0},
        "groundedness": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "completeness": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "citation_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "refusal_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "claim_precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "claim_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "citation_precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "citation_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "refusal_appropriateness": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "unsupported_claim_count": {"type": "integer", "minimum": 0}
      }
    },
    "answerQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "cases"],
      "properties": {
        "metrics": {"$ref": "#/$defs/answerAggregateMetrics"},
        "cases": {
          "type": "array",
          "items": {"$ref": "#/$defs/answerMetrics"}
        }
      }
    },
    "ontologyMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "case_id",
        "entity_precision",
        "entity_recall",
        "relation_precision",
        "relation_recall",
        "evidence_precision",
        "evidence_recall",
        "contradiction_precision",
        "contradiction_recall",
        "path_relevance",
        "path_recall",
        "temporal_accuracy",
        "duplicate_count",
        "orphan_count",
        "acl_leakage_count"
      ],
      "properties": {
        "schema_version": {"const": "kip.ontology-metrics.v1"},
        "case_id": {"type": "string", "minLength": 1},
        "entity_precision": {"$ref": "#/$defs/nullableScore"},
        "entity_recall": {"$ref": "#/$defs/nullableScore"},
        "relation_precision": {"$ref": "#/$defs/nullableScore"},
        "relation_recall": {"$ref": "#/$defs/nullableScore"},
        "evidence_precision": {"$ref": "#/$defs/nullableScore"},
        "evidence_recall": {"$ref": "#/$defs/nullableScore"},
        "contradiction_precision": {"$ref": "#/$defs/nullableScore"},
        "contradiction_recall": {"$ref": "#/$defs/nullableScore"},
        "path_relevance": {"$ref": "#/$defs/nullableScore"},
        "path_recall": {"$ref": "#/$defs/nullableScore"},
        "temporal_accuracy": {"$ref": "#/$defs/nullableScore"},
        "duplicate_count": {"type": "integer", "minimum": 0},
        "orphan_count": {"type": "integer", "minimum": 0},
        "acl_leakage_count": {"type": "integer", "minimum": 0}
      }
    },
    "ontologyAggregateMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "case_count",
        "entity_precision",
        "entity_recall",
        "relation_precision",
        "relation_recall",
        "evidence_precision",
        "evidence_recall",
        "contradiction_precision",
        "contradiction_recall",
        "path_relevance",
        "path_recall",
        "temporal_accuracy",
        "duplicate_count",
        "orphan_count",
        "acl_leakage_count"
      ],
      "properties": {
        "schema_version": {"const": "kip.ontology-aggregate-metrics.v1"},
        "case_count": {"type": "integer", "minimum": 0},
        "entity_precision": {"$ref": "#/$defs/nullableScore"},
        "entity_recall": {"$ref": "#/$defs/nullableScore"},
        "relation_precision": {"$ref": "#/$defs/nullableScore"},
        "relation_recall": {"$ref": "#/$defs/nullableScore"},
        "evidence_precision": {"$ref": "#/$defs/nullableScore"},
        "evidence_recall": {"$ref": "#/$defs/nullableScore"},
        "contradiction_precision": {"$ref": "#/$defs/nullableScore"},
        "contradiction_recall": {"$ref": "#/$defs/nullableScore"},
        "path_relevance": {"$ref": "#/$defs/nullableScore"},
        "path_recall": {"$ref": "#/$defs/nullableScore"},
        "temporal_accuracy": {"$ref": "#/$defs/nullableScore"},
        "duplicate_count": {"type": "integer", "minimum": 0},
        "orphan_count": {"type": "integer", "minimum": 0},
        "acl_leakage_count": {"type": "integer", "minimum": 0}
      }
    },
    "ontologyQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "cases"],
      "properties": {
        "metrics": {"$ref": "#/$defs/ontologyAggregateMetrics"},
        "cases": {
          "type": "array",
          "items": {"$ref": "#/$defs/ontologyMetrics"}
        }
      }
    },
    "nullableScore": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "recall_at_k",
        "mrr",
        "ndcg_at_k",
        "zero_result_rate",
        "unauthorized_result_count",
        "locator_accuracy",
        "latest_version_accuracy",
        "stale_warning_rate"
      ],
      "properties": {
        "case_count": {"type": "integer", "minimum": 0},
        "failed_case_count": {"type": "integer", "minimum": 0},
        "recall_at_k": {"type": "number", "minimum": 0, "maximum": 1},
        "mrr": {"type": "number", "minimum": 0, "maximum": 1},
        "ndcg_at_k": {"type": "number", "minimum": 0, "maximum": 1},
        "zero_result_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "zero_result_recovery_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "unauthorized_result_count": {"type": "integer", "minimum": 0},
        "locator_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "latest_version_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "stale_warning_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p95", "max"],
      "properties": {
        "p50": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "latency_ms", "categories", "cases"],
      "properties": {
        "metrics": {"$ref": "#/$defs/metrics"},
        "latency_ms": {"$ref": "#/$defs/latency"},
        "categories": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/metrics"}
        },
        "cases": {
          "type": "array",
          "items": {"type": "object"}
        },
        "answer_quality": {"$ref": "#/$defs/answerQuality"},
        "ontology_quality": {"$ref": "#/$defs/ontologyQuality"},
        "error": {"type": "string"}
      }
    }
  }
}
