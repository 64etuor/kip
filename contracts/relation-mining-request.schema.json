          "title": "Body",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "id",
        "body",
        "locator"
      ],
      "title": "GenerationEvidence",
      "type": "object"
    },
    "KnowledgeEntity": {
      "additionalProperties": false,
