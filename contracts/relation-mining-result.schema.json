{
  "$defs": {
    "GenerationUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "title": "GenerationUsage",
      "type": "object"
    },
    "MinedEntityProposal": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "canonical_name": {
          "minLength": 1,
          "title": "Canonical Name",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "entity_type": {
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "entity_type",
        "canonical_name",
        "evidence_ids"
      ],
      "title": "MinedEntityProposal",
      "type": "object"
    },
    "MinedProposalSkip": {
      "additionalProperties": false,
      "description": "One invalid or duplicate mined proposal that was skipped, with a reason.\n\nA skipped proposal never becomes a candidate; recording it keeps a single\nbad proposal from failing the whole mining batch while preserving an\nauditable per-proposal explanation.",
      "properties": {
        "kind": {
          "enum": [
            "entity",
            "relation",
            "evidence_unit"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference",
        "reason"
      ],
      "title": "MinedProposalSkip",
      "type": "object"
    },
    "MinedRelationProposal": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "object_entity_id": {
          "minLength": 1,
          "title": "Object Entity Id",
          "type": "string"
        },
        "predicate": {
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "subject_entity_id": {
          "minLength": 1,
          "title": "Subject Entity Id",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "required": [
        "subject_entity_id",
        "predicate",
        "object_entity_id",
        "evidence_ids"
      ],
      "title": "MinedRelationProposal",
      "type": "object"
    },
    "ModelRevision": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "revision"
      ],
      "title": "ModelRevision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entities": {
      "items": {
        "$ref": "#/$defs/MinedEntityProposal"
      },
      "title": "Entities",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ModelRevision"
    },
    "provider_request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Request Id"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/MinedRelationProposal"
      },
      "title": "Relations",
      "type": "array"
    },
    "skipped": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MinedProposalSkip"
      },
      "title": "Skipped",
      "type": "array"
    },
    "usage": {
      "$ref": "#/$defs/GenerationUsage"
    }
  },
  "required": [
    "entities",
    "relations",
    "model",
    "usage"
  ],
  "title": "RelationMiningResult",
  "type": "object"
}
