{
  "$defs": {
    "ContentUnit": {
      "additionalProperties": false,
      "properties": {
        "acl_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Acl Scopes",
          "type": "array"
        },
        "acl_snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acl Snapshot Id"
        },
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "body_normalized": {
          "title": "Body Normalized",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/DataClassification",
          "default": "restricted"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "extraction_id": {
          "title": "Extraction Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "lexical_text": {
          "title": "Lexical Text",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/EvidenceLocator"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "ordinal": {
          "title": "Ordinal",
          "type": "integer"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "unit_type": {
          "title": "Unit Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "extraction_id",
        "artifact_id",
        "ordinal",
        "unit_type",
        "body",
        "body_normalized",
        "lexical_text",
        "locator"
      ],
      "title": "ContentUnit",
      "type": "object"
    },
    "DataClassification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "personal"
      ],
      "title": "DataClassification",
      "type": "string"
    },
    "EvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "data"
      ],
      "title": "EvidenceLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One evidence unit reopened from the canonical store.\n\nThe same model carries the direct `read` result and the bulk reopen used\nto assemble context items and answer citations, which is why\n`source_verification` keeps all three values. The two paths differ, and\nthe field description says how.",
  "properties": {
    "current_source_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Source Sha256"
    },
    "indexed_source_sha256": {
      "title": "Indexed Source Sha256",
      "type": "string"
    },
    "source_changed_since_index": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "true when the live source no longer matches the indexed revision, false when it matched, null when freshness could not be compared. null is unknown, never fresh: read source_verification before reporting staleness.",
      "title": "Source Changed Since Index"
    },
    "source_uri": {
      "title": "Source Uri",
      "type": "string"
    },
    "source_verification": {
      "default": "unavailable",
      "description": "How freshness was checked: stat (indexed size and mtime still matched, no new digest), sha256 (the live source was re-hashed), or unavailable (the source could not be read, so source_changed_since_index is null). A direct read always re-hashes, so it returns only sha256 or unavailable and never stat; stat appears on the bulk reopen paths that fill context items and answer citations.",
      "enum": [
        "stat",
        "sha256",
        "unavailable"
      ],
      "title": "Source Verification",
      "type": "string"
    },
    "unit": {
      "$ref": "#/$defs/ContentUnit"
    }
  },
  "required": [
    "unit",
    "source_uri",
    "indexed_source_sha256"
  ],
  "title": "EvidenceRead",
  "type": "object"
}
