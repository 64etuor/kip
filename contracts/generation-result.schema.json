{
  "$defs": {
    "GeneratedClaim": {
      "additionalProperties": false,
      "properties": {
        "certainty": {
          "enum": [
            "supported",
            "uncertain"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence_ids",
        "certainty"
      ],
      "title": "GeneratedClaim",
      "type": "object"
    },
    "GenerationUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "title": "GenerationUsage",
      "type": "object"
    },
    "ModelRevision": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "revision"
      ],
      "title": "ModelRevision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/GeneratedClaim"
      },
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ModelRevision"
    },
    "provider_request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Request Id"
    },
    "usage": {
      "$ref": "#/$defs/GenerationUsage"
    }
  },
  "required": [
    "claims",
    "model",
    "usage"
  ],
  "title": "GenerationResult",
  "type": "object"
}
