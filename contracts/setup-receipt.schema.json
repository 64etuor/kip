{
  "$defs": {
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonPrimitive": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonPrimitive"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "SetupCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "ok",
        "detail"
      ],
      "title": "SetupCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/SetupCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "plan_fingerprint": {
      "title": "Plan Fingerprint",
      "type": "string"
    },
    "schema_version": {
      "const": "kip.setup-receipt.v1",
      "default": "kip.setup-receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_summaries": {
      "items": {
        "$ref": "#/$defs/JsonObject"
      },
      "title": "Source Summaries",
      "type": "array"
    },
    "verified": {
      "title": "Verified",
      "type": "boolean"
    }
  },
  "required": [
    "plan_fingerprint",
    "verified",
    "checks",
    "source_summaries"
  ],
  "title": "SetupReceipt",
  "type": "object"
}
