{
  "$defs": {
    "CandidateEvidence": {
      "additionalProperties": false,
      "properties": {
        "content_unit_id": {
          "minLength": 1,
          "title": "Content Unit Id",
          "type": "string"
        },
        "locator": {
          "additionalProperties": true,
          "title": "Locator",
          "type": "object"
        },
        "quote_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Hash"
        },
        "source_revision_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Revision Sha256"
        }
      },
      "required": [
        "content_unit_id"
      ],
      "title": "CandidateEvidence",
      "type": "object"
    },
    "RelationDerivation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "manual",
            "deterministic",
            "model",
            "ontology_migration"
          ],
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "kind",
        "name",
        "revision"
      ],
      "title": "RelationDerivation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aliases": {
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "canonical_name": {
      "minLength": 1,
      "title": "Canonical Name",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "derivation": {
      "$ref": "#/$defs/RelationDerivation"
    },
    "entity_type": {
      "minLength": 1,
      "title": "Entity Type",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/CandidateEvidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "fingerprint": {
      "minLength": 1,
      "title": "Fingerprint",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "ontology_version": {
      "minLength": 1,
      "title": "Ontology Version",
      "type": "string"
    },
    "origin": {
      "minLength": 1,
      "title": "Origin",
      "type": "string"
    },
    "review_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Note"
    },
    "status": {
      "default": "proposed",
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "superseded"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "fingerprint",
    "entity_type",
    "canonical_name",
    "origin",
    "ontology_version",
    "evidence",
    "derivation"
  ],
  "title": "EntityCandidate",
  "type": "object"
}
