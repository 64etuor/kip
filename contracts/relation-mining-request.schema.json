    "max_relation_proposals": {
      "default": 64,
      "maximum": 512,
      "minimum": 0,
      "title": "Max Relation Proposals",
      "type": "integer"
    },
    "ontology_version": {
      "minLength": 1,
      "title": "Ontology Version",
      "type": "string"
    }
  },
  "required": [
    "evidence",
    "existing_entities",
    "ontology_version"
  ],
