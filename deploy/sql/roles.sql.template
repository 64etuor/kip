-- Run as the database object owner. Bind platform login roles to these NOLOGIN groups.
-- Local Compose uses kip_owner for convenience; production API and workers must not.

DO $$ BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='kip_api') THEN
    CREATE ROLE kip_api NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='kip_worker') THEN
    CREATE ROLE kip_worker NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='kip_reviewer') THEN
    CREATE ROLE kip_reviewer NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='kip_backup') THEN
    CREATE ROLE kip_backup NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION BYPASSRLS;
  END IF;
END $$;

GRANT CONNECT ON DATABASE kip TO kip_api, kip_worker, kip_reviewer, kip_backup;
GRANT USAGE ON SCHEMA kip, source, content, knowledge, search, jobs, audit TO kip_api, kip_worker, kip_reviewer, kip_backup;
GRANT EXECUTE ON FUNCTION kip.current_workspace_id(), kip.current_acl_scopes(), kip.acl_snapshot_is_fresh(text) TO kip_api, kip_worker, kip_reviewer;

GRANT SELECT ON ALL TABLES IN SCHEMA kip, source, content, knowledge, search, jobs, audit TO kip_api;
GRANT INSERT, UPDATE ON jobs.queue, audit.events, audit.query_traces TO kip_api;
GRANT INSERT, UPDATE ON knowledge.entity_candidates, knowledge.entity_candidate_evidence, knowledge.assertion_candidates, knowledge.assertion_candidate_evidence TO kip_api;

GRANT SELECT ON ALL TABLES IN SCHEMA kip, source, content, knowledge, search, jobs, audit TO kip_worker;
GRANT SELECT, INSERT, UPDATE ON source.systems, source.containers, source.objects, source.revisions, source.sync_cursors, source.acl_snapshots TO kip_worker;
GRANT SELECT, INSERT, UPDATE ON content.logical_documents, content.artifacts, content.document_artifacts, content.extractions, content.units TO kip_worker;
GRANT SELECT, INSERT, UPDATE, DELETE ON search.lexical_units, search.aliases, search.embedding_spaces, search.embeddings_1024 TO kip_worker;
GRANT INSERT, UPDATE ON knowledge.entities, knowledge.entity_identifiers, knowledge.entity_aliases, knowledge.entity_candidates, knowledge.entity_candidate_evidence, knowledge.assertion_candidates, knowledge.assertion_candidate_evidence TO kip_worker;
GRANT SELECT, INSERT, UPDATE, DELETE ON jobs.queue TO kip_worker;
GRANT INSERT ON audit.events, audit.query_traces TO kip_worker;

GRANT SELECT ON ALL TABLES IN SCHEMA source, content, knowledge TO kip_reviewer;
GRANT UPDATE ON knowledge.assertion_candidates TO kip_reviewer;
GRANT INSERT, UPDATE ON knowledge.entities, knowledge.entity_identifiers, knowledge.entity_aliases, knowledge.assertions, knowledge.assertion_evidence TO kip_reviewer;
GRANT UPDATE ON knowledge.entity_candidates TO kip_reviewer;
GRANT INSERT ON audit.events TO kip_reviewer;

GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA source, content, knowledge, search, jobs, audit TO kip_api, kip_worker, kip_reviewer;

GRANT SELECT ON ALL TABLES IN SCHEMA kip, source, content, knowledge, search, jobs, audit TO kip_backup;

ALTER DEFAULT PRIVILEGES IN SCHEMA kip, source, content, knowledge, search, jobs, audit GRANT SELECT ON TABLES TO kip_api, kip_worker, kip_backup;
ALTER DEFAULT PRIVILEGES IN SCHEMA source, content, knowledge GRANT SELECT ON TABLES TO kip_reviewer;
ALTER DEFAULT PRIVILEGES IN SCHEMA source, content, knowledge, search, jobs, audit GRANT USAGE, SELECT ON SEQUENCES TO kip_api, kip_worker, kip_reviewer;

DROP POLICY IF EXISTS worker_workspace_access ON source.objects;
CREATE POLICY worker_workspace_access ON source.objects
    FOR SELECT TO kip_worker
    USING (workspace_id = kip.current_workspace_id());
DROP POLICY IF EXISTS worker_workspace_update ON source.objects;
CREATE POLICY worker_workspace_update ON source.objects
    FOR UPDATE TO kip_worker
    USING (workspace_id = kip.current_workspace_id())
    WITH CHECK (workspace_id = kip.current_workspace_id());
DROP POLICY IF EXISTS worker_workspace_access ON content.units;
CREATE POLICY worker_workspace_access ON content.units
    FOR SELECT TO kip_worker
    USING (workspace_id = kip.current_workspace_id());
DROP POLICY IF EXISTS worker_workspace_update ON content.units;
CREATE POLICY worker_workspace_update ON content.units
    FOR UPDATE TO kip_worker
    USING (workspace_id = kip.current_workspace_id())
    WITH CHECK (workspace_id = kip.current_workspace_id());
