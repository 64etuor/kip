{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kip.local/schemas/golden-case.schema.json",
  "title": "KIP Golden Retrieval Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "question",
    "category",
    "principal",
    "acl_scopes",
    "expected_documents",
    "forbidden_documents",
    "recall_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "principal": {
      "type": "string",
      "minLength": 1
    },
    "acl_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expected_documents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "forbidden_documents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expected_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "object"
          }
        }
      },
      "default": []
    },
    "expected_latest": {
      "type": "boolean"
    },
    "expected_stale_warning": {
      "type": "boolean"
    },
    "recall_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "notes": {
      "type": "string"
    }
  }
}
