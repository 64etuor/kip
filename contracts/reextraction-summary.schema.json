{
  "$defs": {
    "SemanticProjectionUpdate": {
      "additionalProperties": false,
      "description": "What a sync or activation did to the semantic (vector) projection.\n\n``disabled``: semantic search or the embedding adapter is off.\n``current``: nothing new to embed. ``updated``: new or changed units\nwere embedded. ``incomplete``: some eligible units are still missing.\n``unavailable``: the model runtime could not be reached; search keeps\nworking through the lexical path and the next sync resumes.",
      "properties": {
        "activated": {
          "default": false,
          "title": "Activated",
          "type": "boolean"
        },
        "active": {
          "default": false,
          "title": "Active",
          "type": "boolean"
        },
        "content_units": {
          "default": 0,
          "title": "Content Units",
          "type": "integer"
        },
        "indexed_units": {
          "default": 0,
          "title": "Indexed Units",
          "type": "integer"
        },
        "newly_indexed_units": {
          "default": 0,
          "title": "Newly Indexed Units",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "space_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Space Id"
        },
        "status": {
          "enum": [
            "disabled",
            "current",
            "updated",
            "incomplete",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "SemanticProjectionUpdate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activate": {
      "default": false,
      "title": "Activate",
      "type": "boolean"
    },
    "activated": {
      "default": 0,
      "title": "Activated",
      "type": "integer"
    },
    "eligible": {
      "default": 0,
      "title": "Eligible",
      "type": "integer"
    },
    "extensions": {
      "items": {
        "type": "string"
      },
      "title": "Extensions",
      "type": "array"
    },
    "failed": {
      "default": 0,
      "title": "Failed",
      "type": "integer"
    },
    "parsed": {
      "default": 0,
      "title": "Parsed",
      "type": "integer"
    },
    "parser_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Parser Counts",
      "type": "object"
    },
    "rejected": {
      "default": 0,
      "title": "Rejected",
      "type": "integer"
    },
    "scanned": {
      "default": 0,
      "title": "Scanned",
      "type": "integer"
    },
    "semantic_projection": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticProjectionUpdate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "skipped": {
      "default": 0,
      "title": "Skipped",
      "type": "integer"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "unit_count": {
      "default": 0,
      "title": "Unit Count",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "source"
  ],
  "title": "ReextractionSummary",
  "type": "object"
}
