{
  "$defs": {
    "OntologyDiscoveryRelease": {
      "additionalProperties": false,
      "description": "Result of materializing an accepted discovery candidate into the ontology tree.",
      "properties": {
        "catalog_refresh": {
          "enum": [
            "applied",
            "restart_required"
          ],
          "title": "Catalog Refresh",
          "type": "string"
        },
        "file": {
          "maxLength": 256,
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "kind": {
          "enum": [
            "entity_type",
            "predicate",
            "controlled_value",
            "alias"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "kip.ontology-release.v1",
          "default": "kip.ontology-release.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "symbol": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "symbol",
        "file",
        "version",
        "catalog_refresh"
      ],
      "title": "OntologyDiscoveryRelease",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "definition": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Definition",
      "type": "string"
    },
    "domain": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain"
    },
    "domain_profile": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Domain Profile",
      "type": "string"
    },
    "extraction": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extraction"
    },
    "fingerprint": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Fingerprint",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "inverse": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inverse"
    },
    "kind": {
      "enum": [
        "entity_type",
        "predicate",
        "controlled_value",
        "alias"
      ],
      "title": "Kind",
      "type": "string"
    },
    "label": {
      "maxLength": 140,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "occurrence_count": {
      "default": 1,
      "minimum": 1,
      "title": "Occurrence Count",
      "type": "integer"
    },
    "parent": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent"
    },
    "range": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Range"
    },
    "release": {
      "anyOf": [
        {
          "$ref": "#/$defs/OntologyDiscoveryRelease"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review": {
      "anyOf": [
        {
          "enum": [
            "not_required",
            "conditional",
            "required"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review"
    },
    "review_note": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Note"
    },
    "reviewed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed At"
    },
    "reviewed_by": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed By"
    },
    "risk": {
      "anyOf": [
        {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risk"
    },
    "schema_version": {
      "const": "kip.ontology-discovery-candidate.v1",
      "default": "kip.ontology-discovery-candidate.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "default": "proposed",
      "enum": [
        "proposed",
        "accepted_for_release",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "symbol": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Symbol",
      "type": "string"
    },
    "target_symbol": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Symbol"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "domain_profile",
    "kind",
    "symbol",
    "label",
    "definition",
    "fingerprint"
  ],
  "title": "OntologyDiscoveryCandidate",
  "type": "object"
}
