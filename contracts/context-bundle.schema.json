{
  "$defs": {
    "ContextItem": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "title": "Body",
          "type": "string"
        },
        "body_truncated": {
          "default": false,
          "description": "When true, body is only the leading portion of the evidence unit.",
          "title": "Body Truncated",
          "type": "boolean"
        },
        "current_source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Source Sha256"
        },
        "hit": {
          "$ref": "#/$defs/SearchHit"
        },
        "source_changed_since_index": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Changed Since Index"
        },
        "source_verification": {
          "default": "unavailable",
          "enum": [
            "stat",
            "sha256",
            "unavailable"
          ],
          "title": "Source Verification",
          "type": "string"
        }
      },
      "required": [
        "hit",
        "body"
      ],
      "title": "ContextItem",
      "type": "object"
    },
    "EvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "data"
      ],
      "title": "EvidenceLocator",
      "type": "object"
    },
    "SearchHit": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "evidence_role": {
          "const": "discovery",
          "default": "discovery",
          "description": "Candidate preview; reopen the unit before citing facts.",
          "title": "Evidence Role",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/EvidenceLocator"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        },
        "source_kind": {
          "title": "Source Kind",
          "type": "string"
        },
        "source_modified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Modified At"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        },
        "source_uri": {
          "title": "Source Uri",
          "type": "string"
        },
        "source_verification": {
          "const": "not_checked",
          "default": "not_checked",
          "description": "Search hashes describe the index, not a live source check.",
          "title": "Source Verification",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unit_id": {
          "title": "Unit Id",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "artifact_id",
        "source_kind",
        "title",
        "snippet",
        "score",
        "locator",
        "source_uri",
        "source_sha256"
      ],
      "title": "SearchHit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ContextItem"
      },
      "title": "Items",
      "type": "array"
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "total_chars": {
      "title": "Total Chars",
      "type": "integer"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "query",
    "items",
    "total_chars",
    "truncated"
  ],
  "title": "ContextBundle",
  "type": "object"
}
