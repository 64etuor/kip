{
  "$defs": {
    "AclSnapshot": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "configuration_owned": {
          "default": false,
          "title": "Configuration Owned",
          "type": "boolean"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "provider",
        "captured_at"
      ],
      "title": "AclSnapshot",
      "type": "object"
    },
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Size"
        },
        "cas_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cas Uri"
        },
        "extension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extension"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "representation_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Representation Role"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        }
      },
      "required": [
        "id",
        "revision_id",
        "file_name",
        "sha256"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "DataClassification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "personal"
      ],
      "title": "DataClassification",
      "type": "string"
    },
    "LogicalDocument": {
      "additionalProperties": false,
      "properties": {
        "document_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Type"
        },
        "family_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family Key"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "lifecycle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lifecycle"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "stable_key": {
          "title": "Stable Key",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "stable_key",
        "title"
      ],
      "title": "LogicalDocument",
      "type": "object"
    },
    "SourceObject": {
      "additionalProperties": false,
      "properties": {
        "acl_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Acl Scopes",
          "type": "array"
        },
        "acl_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/AclSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "canonical_uri": {
          "title": "Canonical Uri",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/DataClassification",
          "default": "restricted"
        },
        "container_external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container External Id"
        },
        "external_id": {
          "title": "External Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "object_type": {
          "title": "Object Type",
          "type": "string"
        },
        "system_id": {
          "title": "System Id",
          "type": "string"
        },
        "system_kind": {
          "title": "System Kind",
          "type": "string"
        },
        "system_name": {
          "title": "System Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "system_id",
        "system_name",
        "system_kind",
        "external_id",
        "object_type",
        "canonical_uri"
      ],
      "title": "SourceObject",
      "type": "object"
    },
    "SourceRevision": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "is_tombstone": {
          "default": false,
          "title": "Is Tombstone",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "raw_object_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Object Uri"
        },
        "revision_key": {
          "title": "Revision Key",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "source_modified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Modified At"
        }
      },
      "required": [
        "id",
        "object_id",
        "revision_key",
        "sha256"
      ],
      "title": "SourceRevision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/$defs/Artifact"
    },
    "document": {
      "anyOf": [
        {
          "$ref": "#/$defs/LogicalDocument"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRevision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_object": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceObject"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "artifact"
  ],
  "title": "ArtifactView",
  "type": "object"
}
