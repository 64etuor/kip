{
  "$defs": {
    "DraftReviewDecision": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "approve",
            "reject"
          ],
          "title": "Action",
          "type": "string"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "case_id",
        "action"
      ],
      "title": "DraftReviewDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
